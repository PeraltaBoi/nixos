let
  # Helper function to recursively find .nix files in directories
  recReadDir = dir: builtins.filter (name: builtins.match ".*\\.nix" name != null) (builtins.attrNames (builtins.readDir dir));

  # Read files from the current directory and plugins directory
  files = builtins.readDir ./.;
  pluginFiles = builtins.readDir ./plugins;

  # Recursively get all .nix files in the plugins directory
  pluginNixFiles = recReadDir ./plugins;

  # Combine the files and plugins directories (filter out 'default.nix')
  nixFiles = builtins.filter (name: name != "default.nix") (builtins.attrNames files ++ pluginNixFiles);

  # Create a list of import statements for both directories
  imports = map (name: 
    if builtins.elem name (builtins.attrNames files)
    then ./. + "/${name}"
    else ./plugins + "/${name}"
  ) nixFiles;
in
{
  programs.nixvim = {
    enable = true;
  };

  # Import all configuration modules automatically
  inherit imports;
}
